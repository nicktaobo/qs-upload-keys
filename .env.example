PORT=3000
APP_PORT=3001
DATABASE_URL=postgresql://user:password@db.example.com:5432/qushu
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key

ADMIN_USERNAME=admin
# Wrap values containing # in quotes so they are not parsed as comments.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Source platform credentials are server-only. Never put them in VITE_* variables.
UPSTREAM_BASE_URL=https://cnx.aicombo.com
UPSTREAM_USERNAME=replace-me
UPSTREAM_PASSWORD=replace-me
UPSTREAM_TIMEOUT_MS=10000
# Optional. Required when the server reaches the source platform through a proxy.
UPSTREAM_PROXY_URL=
UPSTREAM_WRITE_ENABLED=false

VITE_API_MODE=true
